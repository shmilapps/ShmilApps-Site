{
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "functions": {
    "api/research-payment-reconcile.js": {"maxDuration":120},
    "api/research-orders.js": {
      "maxDuration": 60
    },
    "api/research-payment-return.js": {
      "maxDuration": 120
    },
    "api/sumit-payment-test.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
